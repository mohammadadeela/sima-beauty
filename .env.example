# Copy this file to .env and fill it in.  Never commit .env.

# PostgreSQL connection for the Sima Beauty database
DATABASE_URL=postgres://sima:CHANGE_ME@127.0.0.1:5432/sima

# Long random string (run: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Port the app listens on (nginx proxies your domain to it).
# Lucerne uses 5000, so Sima uses 5001.
PORT=5001

# Your public address, used for links and search engines
SITE_URL=https://www.your-domain.com

# First admin account. Created automatically the first time the app starts.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# OPTIONAL: true = generate fake products, customers, orders and reviews on an EMPTY DB.
# Test data is not removed when this is changed back to false.
# Never enable on a database intended for real sales.
SEED_DEMO=false
